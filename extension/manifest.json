{
  "manifest_version": 3,
  "name": "TruthLens",
  "version": "1.0.0",
  "description": "Highlight any text and get a unified Trust Score: AI-generation, toxicity and fact-check, all from local models.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TruthLens",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "commands": {
    "analyze-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+T"
      },
      "description": "Analyze the current selection with TruthLens"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/public-sans.woff2",
        "fonts/instrument-serif.woff2"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
